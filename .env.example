# Copy to .env, then replace both placeholders. Never commit real credentials.
CRAFT_SPACE_BASE_URL=https://connect.craft.do/links/REPLACE_ME/api/v1
WRAPPER_API_TOKEN=REPLACE_ME
CRAFT_TIMEOUT_SECONDS=30
CRAFT_CONNECT_TIMEOUT_SECONDS=5
# Optional: omit to enable all 13 v1 operations. Blank/unknown entries are errors.
# WRAPPER_ENABLED_OPERATIONS=craft_space_list_documents,craft_space_get_block,craft_space_read_markdown
# Optional non-secret origin; omit to let consumers use the schema's origin.
# WRAPPER_PUBLIC_URL=http://localhost:8000
